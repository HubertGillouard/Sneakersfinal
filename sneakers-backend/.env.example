# ─── Backend SneakR ───────────────────────────────────────────────────────────
# Copiez ce fichier en .env et remplissez les valeurs.
# Ne commitez JAMAIS le fichier .env.

# Port du serveur Express
PORT=5051

# Secret utilisé pour signer les tokens JWT (changez en production)
JWT_SECRET=sneakr-secret-change-me

# Clé API KicksDB (optionnelle)
# Si renseignée : npm run mapping:api utilise l'API pour importer de vraies sneakers.
# Si absente   : fallback vers catalogues publics Shopify, puis catalogue local.
# Obtenez une clé sur https://kicks.dev
KICKSDB_API_KEY=

# Nombre de produits à importer (minimum recommandé : 100)
MAPPING_TARGET=120
